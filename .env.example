# Optional: using an API provider enables AI-generated questions and summaries.
OPENAI_API_KEY=
SEED_OPENAI_API_KEY=
SEED_LANG=en
SEED_AI_TIMEOUT_MS=30000
# Optional OpenAI-compatible endpoint (defaults to https://api.openai.com/v1)
SEED_OPENAI_BASE_URL=
# API-key mode model; OAuth mode uses the setting below.
SEED_OPENAI_MODEL=gpt-5.6-luna
SEED_OPENAI_OAUTH_MODEL=gpt-5.6-luna
# Optional path override; defaults to ~/.seed/oauth/openai.json
SEED_OPENAI_AUTH_FILE=
SEED_GEMINI_API_KEY=
GEMINI_API_KEY=
SEED_ANTHROPIC_API_KEY=
# Custom providers: SEED_<PROVIDER_ID>_API_KEY (non-alphanumeric -> _) or generic SEED_API_KEY
SEED_API_KEY=
